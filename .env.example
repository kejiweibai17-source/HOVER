# 複製為 .env.local 後填入實際值
# cp .env.example .env.local

# =============================================================================
# 會員登入 / 註冊 / OAuth
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 前台商品分類（Header 子選單、首頁分類區）— 設為 true 才顯示
NEXT_PUBLIC_SHOW_PRODUCT_CATEGORIES=false
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
RESET_TOKEN_SECRET=

WC_API_BASE=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WORDPRESS_API_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_CHANNEL_ID=
LINE_CALLBACK_URL=http://localhost:3000/api/auth/line/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

ADMIN_EMAILS=

# =============================================================================
# 綠界 ECPay
# =============================================================================
NEXT_PUBLIC_ECPAY_MERCHANT_ID=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_API_URL=https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SKIP_ECPAY_ON_LOCAL=true

# =============================================================================
# LINE Pay
# =============================================================================
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
LINEPAY_SITE=https://api-pay.line.me
