# 複製為 .env.local 後填入實際值
# cp .env.example .env.local

# =============================================================================
# 會員登入 / 註冊 / OAuth
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 前台商品分類（Header 子選單、首頁分類區）— 設為 true 才顯示
NEXT_PUBLIC_SHOW_PRODUCT_CATEGORIES=false
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
RESET_TOKEN_SECRET=

WC_API_BASE=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WORDPRESS_API_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_CHANNEL_ID=
LINE_CALLBACK_URL=http://localhost:3000/api/auth/line/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 會員信件顯示的寄件地址（與 SMTP 登入帳可不同；Workspace 需已允許「以此地址傳送」）
MAIL_FROM=service@hoverofficial.com
MAIL_FROM_NAME=HOVER

ADMIN_EMAILS=

# Cloudflare Turnstile（登入／註冊／社群綁定人機驗證）
# https://dash.cloudflare.com/ → Turnstile → 建立網站小工具
# 未填則本機／正式站都會跳過 CAPTCHA（僅剩次數限制）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 指定商品免運：購物車僅含這些 Woo product id 時運費為 0（逗號分隔）
# NEXT_PUBLIC_FREE_SHIPPING_PRODUCT_IDS=1819

# =============================================================================
# 綠界 ECPay（金流＋超商地圖＋發票）
# =============================================================================
# 切換：stage | production（ECPAY_ENV 與 NEXT_PUBLIC_ECPAY_ENV 請一致）
ECPAY_ENV=stage
NEXT_PUBLIC_ECPAY_ENV=stage
ECPAY_INVOICE_ENV=stage
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SKIP_ECPAY_ON_LOCAL=false

# STAGE（測試官方）
# C2C 地圖：MerchantID=2000933  HashKey=XBERn1YOvpM9nfZc  HashIV=h1ONHk4P4yqbl5LK
# 金流：MerchantID=2000132  HashKey=5294y06JbISpM5x9  HashIV=v77hoKGq4kWxNNIS
ECPAY_STAGE_MERCHANT_ID=
ECPAY_STAGE_HASH_KEY=
ECPAY_STAGE_HASH_IV=
ECPAY_STAGE_LOGISTICS_MERCHANT_ID=
NEXT_PUBLIC_ECPAY_STAGE_MERCHANT_ID=
ECPAY_STAGE_INVOICE_MERCHANT_ID=
ECPAY_STAGE_INVOICE_HASH_KEY=
ECPAY_STAGE_INVOICE_HASH_IV=

# PRODUCTION（正式商店三碼）
ECPAY_PROD_MERCHANT_ID=
ECPAY_PROD_HASH_KEY=
ECPAY_PROD_HASH_IV=
ECPAY_PROD_LOGISTICS_MERCHANT_ID=
NEXT_PUBLIC_ECPAY_PROD_MERCHANT_ID=
ECPAY_PROD_INVOICE_MERCHANT_ID=
ECPAY_PROD_INVOICE_HASH_KEY=
ECPAY_PROD_INVOICE_HASH_IV=

# 舊變數後備（可選）
NEXT_PUBLIC_ECPAY_MERCHANT_ID=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_INVOICE_MERCHANT_ID=
ECPAY_INVOICE_HASH_KEY=
ECPAY_INVOICE_HASH_IV=

# =============================================================================
# LINE Pay
# =============================================================================
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
LINEPAY_SITE=https://api-pay.line.me
